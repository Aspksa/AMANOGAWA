# Настройки AMANOGAWA. Удобнее менять их на сайте: страница «Настройки» (шестерёнка).
# AMANOGAWA.BAT сам копирует этот файл в .env; .env не попадает в git — ключ остаётся только у вас.

# Ключ API Cloud.ru Foundation Models (console.cloud.ru → Foundation Models → API-ключи)
CLOUDRU_API_KEY=

# OpenAI-совместимый адрес Cloud.ru
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Модели (точные имена — в каталоге Foundation Models в консоли Cloud.ru)
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Размер вектора эмбеддингов. Пусто — определится автоматически.
EMBEDDING_DIM=
# Модель со зрением для описания картинок в PDF. Пусто — картинки пропускаются.
VISION_MODEL=

# Режим поиска: mix, hybrid, local, global, naive
QUERY_MODE=mix
# Сколько результатов поиска брать и сколько прошлых вопросов помнить в диалоге
TOP_K=40
HISTORY_TURNS=3
# Язык описаний сущностей в графе знаний
SUMMARY_LANGUAGE=Russian

# Парсер для PDF/Office: mineru, docling или paddleocr
PARSER=mineru
